# Copy to .env and fill in. All values are optional.

# API key from https://console.anthropic.com (Settings > API keys).
# If empty, paste the key in the web page instead (kept only in that browser tab).
ANTHROPIC_API_KEY=

# OpenAI API key from https://platform.openai.com (API keys).
# If empty, paste it in the OpenAI field in Settings (kept only in that browser tab).
OPENAI_API_KEY=

# Default Claude model; the page lets you switch.
CLAUDE_MODEL=claude-sonnet-5
# Fallback model list (comma separated), used only if the models of your key cannot be read.
# Leave empty to use the built-in list.
CLAUDE_MODELS=

# Default and fallback OpenAI models. Leave OPENAI_MODELS empty to use the built-in list.
OPENAI_MODEL=gpt-4.1
OPENAI_MODELS=

# Port on your machine
HOST_PORT=8421

# Behind a corporate proxy: CA bundle placed in ./certs (see README)
# SSL_CERT_FILE=/certs/ca-bundle.crt

# Simulations run in parallel up to this many (default: CPU cores - 1)
MAX_PARALLEL=
# Upper limit on runs in one sweep
MAX_SWEEP_RUNS=400

# Stop the assistant (and the runs it would start) after this many tokens per server session. 0 = no limit.
TOKEN_BUDGET=0

# Run catalog (Postgres, started by docker compose). The agent queries it with read-only SQL.
# Password of the local database; it is not exposed outside Docker.
POSTGRES_PASSWORD=spinmate
# Leave unset to use the bundled database. Set to an empty value to switch the catalog off.
# DATABASE_URL=
# Longest time one catalog query may run, in milliseconds
QUERY_TIMEOUT_MS=5000
