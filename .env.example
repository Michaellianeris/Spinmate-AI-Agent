# Copy to .env and fill in. All values are optional.

# API key from https://console.anthropic.com (Settings > API keys).
# If empty, paste the key in the web page instead (kept only in that browser tab).
ANTHROPIC_API_KEY=

# OpenAI API key from https://platform.openai.com (API keys).
# If empty, paste it in the OpenAI field in Settings (kept only in that browser tab).
OPENAI_API_KEY=

# Default Claude model; the page lets you switch.
CLAUDE_MODEL=claude-sonnet-5
# Fallback model list (comma separated), used only if the models of your key cannot be read.
# Leave empty to use the built-in list.
CLAUDE_MODELS=

# Default and fallback OpenAI models. Leave OPENAI_MODELS empty to use the built-in list.
OPENAI_MODEL=gpt-4.1
OPENAI_MODELS=

# Port on your machine
HOST_PORT=8421
# Who can open the app. 127.0.0.1 = this computer only (default). 0.0.0.0 shares it with your whole
# network, without a password and with your API key: do that only behind a proxy with a real login.
BIND_ADDRESS=127.0.0.1

# Behind a corporate proxy: CA bundle placed in ./certs (see README)
# SSL_CERT_FILE=/certs/ca-bundle.crt

# Simulations run in parallel up to this many (default: CPU cores - 1)
MAX_PARALLEL=
# Upper limit on runs in one sweep
MAX_SWEEP_RUNS=400

# Stop the assistant (and the runs it would start) after this many tokens per server session. 0 = no limit.
# Also set a monthly spend limit in the Anthropic and OpenAI consoles.
TOKEN_BUDGET=2000000

# Run catalog (Postgres, started by docker compose). The agent queries it with read-only SQL.
# Password of the local database; it is not exposed outside Docker. Change it: the default is public.
POSTGRES_PASSWORD=change-me
# Leave unset to use the bundled database. Set to an empty value to switch the catalog off.
# DATABASE_URL=
# Longest time one catalog query may run, in milliseconds
QUERY_TIMEOUT_MS=5000

# Runs or sweeps estimated above this wall time (minutes) or number of runs wait for the Run it button
CONFIRM_MINUTES=10
CONFIRM_RUNS=40
# Cost estimate next to the token counter: exchange rate, and optional price overrides (USD per million tokens)
# Leave empty to use the daily ECB reference rate (fetched once a day, last rate kept offline).
EUR_PER_USD=
# PRICES_JSON={"claude-sonnet-5-5": [2, 10, 2.5, 0.1]}

# Welcome email (optional). When a user creates an account, SpinMate sends the logo, a greeting and the PDF
# user guide. Without SMTP_HOST the email is saved to workspace/outbox instead of being sent.
# Gmail: smtp.gmail.com, port 587, your address as SMTP_USER and an App Password (Google account > Security).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Link of the "Open SpinMate" button in the email (default: the address the user opened the app on)
APP_URL=
